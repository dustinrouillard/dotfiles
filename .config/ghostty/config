auto-update = "download"
working-directory = home
quick-terminal-position = top

link-url = false
theme = dark:"Ultra Dark",light:"GitHub Light High Contrast"

font-family = "Operator Mono Lig Book"
font-family-bold = "Operator Mono Book"
font-family-italic = "Operator Mono Lig Book Italic"
font-family-bold-italic = "Operator Mono Lig Book Italic"

keybind = "global:alt+ctrl+enter=toggle_quick_terminal"
keybind = "global:alt+enter=new_window"

macos-option-as-alt = true
macos-titlebar-style = tabs
macos-non-native-fullscreen = false
macos-titlebar-proxy-icon = "hidden"

window-theme = ghostty
window-height = 40
window-width = 160
window-inherit-working-directory = false
